# Static analysis for the CLI.
#
# The engine and the editor are loaded from the project being worked on rather
# than required here, so their names are ignored: the commands guard on them
# at runtime.
#
# Needs phpstan 2.x. The 1.x line cannot parse `new Thing()->method()`, which
# is PHP 8.4 syntax this codebase uses; run `composer update` if the analyser
# reports syntax errors.
parameters:
    # Level 3 is free here. The engine sits at 0 for now: its next levels are
    # mostly serialization patterns the analyser cannot see through.
    level: 3
    paths:
        - src
    # BattleCommand calls the engine's global asset() helper after loading a
    # target project's engine autoloader at runtime. Scan its declaration so
    # PHPStan sees the same function without booting a game project.
    scanFiles:
        - ../engine/src/Util/Helpers.php
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Ichiloto\\(Engine|Editor)#'
