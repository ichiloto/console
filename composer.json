{
    "name": "ichiloto/console",
    "description": "A simple CLI tool for managing games made using the Ichiloto Game Engine.",
    "type": "library",
    "require": {
        "php": "^8.4.1",
        "symfony/console": "^8.0",
        "laravel/prompts": "^0.3.1",
        "league/climate": "^3.8",
        "ichiloto/editor": "^0.5",
        "amasiye/figlet": "^1.2.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ichiloto\\Console\\": "src/"
        },
        "files": [
            "src/Util/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ichiloto\\Editor\\": "../editor/src",
            "Ichiloto\\Engine\\": "../engine/src",
            "Amasiye\\Figlet\\": "../figlet/src/Figlet"
        }
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "amasiye313@gmail.com"
        }
    ],
    "bin": [
        "bin/ichiloto"
    ],
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php tests/portable-composer-dependencies.php",
            "@php tests/local-sibling-autoload.php",
            "@php tests/generate-map.php",
            "@php tests/new-project-save-compatibility.php",
            "@php tests/legacy-project-upgrade.php",
            "@php tests/validate-working-directory.php",
            "@php tests/battle-report.php"
        ]
    }
}
