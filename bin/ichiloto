#!/usr/bin/env php
<?php

// Composer's bin proxy names the autoloader of the project that installed
// the Console (a global install included); a checkout has its own vendor,
// and an installed package sits in vendor/ichiloto/console.
$autoloadPath = $GLOBALS['_composer_autoload_path'] ?? null;

if (! is_string($autoloadPath) || ! file_exists($autoloadPath)) {
    $autoloadPath = file_exists(__DIR__ . '/../vendor/autoload.php')
        ? __DIR__ . '/../vendor/autoload.php'
        : __DIR__ . '/../../../autoload.php';
}

if (file_exists($autoloadPath)) {
    require_once $autoloadPath;
} else {
    echo 'You must set up the project dependencies, run the following commands:'.PHP_EOL.
        'curl -s http://getcomposer.org/installer | php'.PHP_EOL.
        'php composer.phar install'.PHP_EOL;
    exit(1);
}

use Ichiloto\Console\Commands\BattleCommand;
use Ichiloto\Console\Commands\EditCommand;
use Ichiloto\Console\Commands\EditHostCommand;
use Ichiloto\Console\Commands\GenerateActorCommand;
use Ichiloto\Console\Commands\GenerateFigletCommand;
use Ichiloto\Console\Commands\GenerateMapCommand;
use Ichiloto\Console\Commands\MapApplyCommand;
use Ichiloto\Console\Commands\MapConvertKindsCommand;
use Ichiloto\Console\Commands\MapRenderCommand;
use Ichiloto\Console\Commands\NewCommand;
use Ichiloto\Console\Commands\PlayCommand;
use Ichiloto\Console\Commands\RendererInstallCommand;
use Ichiloto\Console\Commands\RendererListCommand;
use Ichiloto\Console\Commands\RendererUpdateCommand;
use Ichiloto\Console\Commands\UpgradeCommand;
use Ichiloto\Console\Commands\ValidateCommand;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;

function bootstrap(): int
{
  try {
    $app = new Application();
    $app
      ->setDefaultCommand("list")
      ->addCommands([
      new NewCommand(),
      new PlayCommand(),
      new BattleCommand(),
      new EditCommand(),
      new EditHostCommand(),
      new GenerateMapCommand(),
      new MapApplyCommand(),
      new MapConvertKindsCommand(),
      new MapRenderCommand(),
      new GenerateActorCommand(),
      new GenerateFigletCommand(),
      new RendererInstallCommand(),
      new RendererListCommand(),
      new RendererUpdateCommand(),
      new UpgradeCommand(),
      new ValidateCommand()
    ]);
    $app->setAutoExit(false);

    return $app->run();
  } catch (\Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);

    return Command::FAILURE;
  }
}

exit(bootstrap());
