#!/usr/bin/env php
<?php

if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
} elseif (file_exists(__DIR__ . '/../../../vendor/autoload.php')) {
    require_once __DIR__ . '/../../../vendor/autoload.php';
} else {
    echo 'You must set up the project dependencies, run the following commands:'.PHP_EOL.
        'curl -s http://getcomposer.org/installer | php'.PHP_EOL.
        'php composer.phar install'.PHP_EOL;
    exit(1);
}

use Ichiloto\Console\Commands\BattleCommand;
use Ichiloto\Console\Commands\EditCommand;
use Ichiloto\Console\Commands\GenerateActorCommand;
use Ichiloto\Console\Commands\GenerateMapCommand;
use Ichiloto\Console\Commands\PlayCommand;
use Symfony\Component\Console\Application;

function bootstrap(): void
{
  try {
    $app = new Application();
    $app
      ->setDefaultCommand("list")
      ->addCommands([
      new PlayCommand(),
      new BattleCommand(),
      new EditCommand(),
      new GenerateMapCommand(),
      new GenerateActorCommand()
    ]);
    $app->run();
  } catch (Exception $exception) {
    echo $exception->getMessage() . PHP_EOL;
  }
}

bootstrap();
